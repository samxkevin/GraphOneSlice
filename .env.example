# Copy to .env and fill in real values. Never commit .env.

# --- Database ---
DATABASE_URL=postgresql://graphone:changeme@localhost:5432/graphone
DB_POOL_MIN_SIZE=2
DB_POOL_MAX_SIZE=10

# --- arXiv ---
ARXIV_API_BASE=http://export.arxiv.org/api/query
ARXIV_REQUEST_DELAY_SECONDS=3.5
ARXIV_PAGE_SIZE=100
ARXIV_MAX_RESULTS=2000
ARXIV_SEARCH_QUERY=cat:cs.AI
ARXIV_HTTP_TIMEOUT_SECONDS=20.0

# --- GitHub ---
# Personal access token with public_repo read scope. Required for the
# 5,000 req/hr authenticated tier (unauthenticated is 60/hr).
GITHUB_TOKEN=
GITHUB_API_BASE=https://api.github.com
GITHUB_MAX_CONCURRENCY=5
GITHUB_HTTP_TIMEOUT_SECONDS=15.0

# --- Retry / backoff ---
MAX_RETRY_ATTEMPTS=5
RETRY_BACKOFF_BASE_SECONDS=1.0
RETRY_BACKOFF_MAX_SECONDS=60.0
RETRY_JITTER_SECONDS=0.5

# --- Google Sheets ---
# Path to a service-account JSON key file (never commit the file itself).
# Share the target spreadsheet with the service account's client_email.
GOOGLE_SERVICE_ACCOUNT_JSON_PATH=./secrets/service-account.json
GOOGLE_SHEETS_SPREADSHEET_ID=
SHEETS_RESEARCH_PAPERS_TAB=Research Papers
SHEETS_BATCH_SIZE=500
SHEETS_HTTP_TIMEOUT_SECONDS=30.0

# --- Pipeline ---
PIPELINE_BATCH_SIZE=50
LOG_LEVEL=INFO

# --- AI Orbit vertical slice ---
# Runs without secrets. GITHUB_TOKEN is optional but increases GitHub REST API limits.
AI_ORBIT_OUTPUT_DIR=data
AI_ORBIT_HTTP_TIMEOUT_SECONDS=20.0
AI_ORBIT_MAX_RETRY_ATTEMPTS=3
AI_ORBIT_RETRY_BACKOFF_BASE_SECONDS=0.5
AI_ORBIT_RETRY_BACKOFF_MAX_SECONDS=8.0
AI_ORBIT_RETRY_JITTER_SECONDS=0.25
AI_ORBIT_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
AI_ORBIT_GITHUB_SEARCH_QUERY=topic:artificial-intelligence stars:>1000
AI_ORBIT_GITHUB_SEARCH_LIMIT=5
AI_ORBIT_OFFICIAL_SDK_MODEL_LIMIT_PER_PROVIDER=8
AI_ORBIT_NPM_SEARCH_TOOL_LIMIT_PER_QUERY=6
AI_ORBIT_NPM_SEARCH_TOOL_MAX_RECORDS=24
AI_ORBIT_AI_TOOLS_PRODUCT_DIRECTORY_API_URL=https://api.github.com/repos/lakey009/AI-Tools-List/contents/AIToolsList-Sample.json
AI_ORBIT_AI_TOOLS_PRODUCT_LIMIT=50
AI_ORBIT_MODELS_DEV_GITHUB_CATALOG_API_URL=https://api.github.com/repos/anomalyco/models.dev/contents/models.json?ref=dev
AI_ORBIT_MODELS_DEV_MODEL_LIMIT=12
AI_ORBIT_ROS_ROBOTS_CATALOG_API_URL=https://api.github.com/repos/ros-infrastructure/robots.ros.org/contents/_posts
AI_ORBIT_ROS_ROBOTS_LIMIT=15
AI_ORBIT_HUGGINGFACE_MODELS_URL=https://huggingface.co/api/models
AI_ORBIT_OPENAI_RSS_URL=https://openai.com/news/rss.xml
